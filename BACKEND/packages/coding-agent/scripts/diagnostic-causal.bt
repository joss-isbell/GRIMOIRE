  printf("{\"event\":\"signal_generate\",\"time_ns\":\"%llu\",\"context_init_pid\":%d,\"context_init_tid\":%d,\"context_start_boottime_ns\":\"%llu\",\"target_init_pid\":%d,\"target_init_tid\":%d,\"target_start_boottime_ns\":\"%llu\",\"signal\":%d,\"code\":%d,\"group\":%d,\"result\":%d,\"call_time_ns\":\"%llu\",\"oom_call_time_ns\":\"%llu\",\"oom_send_time_ns\":\"%llu\",\"oom_preempt_count\":%u}\n", nsecs(boot), pid(init), tid(init), curtask->start_boottime, args.task->tgid, args.task->pid, args.task->start_boottime, args.sig, $code, args.group, args.result, $callTime, $oomTime, $sendTime, $preempt);
