/@oom[tid(init)].0 && @oom[tid(init)].1 == curtask->start_boottime/
{
  printf("{\"event\":\"oom_kill_return\",\"time_ns\":\"%llu\",\"call_time_ns\":\"%llu\",\"context_init_tid\":%d,\"context_start_boottime_ns\":\"%llu\",\"context_valid\":%d}\n", nsecs(boot), @oom[tid(init)].0, tid(init), curtask->start_boottime, @oom[tid(init)].4);
  $old = delete(@oom, tid(init));
  $pending = delete(@oom_send, tid(init));
}

fentry:vmlinux:do_send_sig_info
/@oom[tid(init)].0 && @oom[tid(init)].1 == curtask->start_boottime && args.sig == 9 && (uint64)args.info == 1 && args.type == 1/
{
  $oom = @oom[tid(init)];
  $prior = @oom_send[tid(init)];
  $preempt = oom_task_context();
  if ($prior.0 && $prior.1 == curtask->start_boottime) {
    @oom_send[tid(init)] = ($prior.0, $prior.1, $prior.2, $prior.3, $prior.4, $prior.5, $prior.6, 0);
    printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"oom_nested_signal\"}\n", nsecs(boot));
  } else if ($oom.4 && $preempt && $oom.2 == args.p->tgid && $oom.3 == args.p->group_leader->start_boottime) {
    discover(args.p, @owned, @ancestry_limits);
    if (owned(args.p, @owned)) {
      @oom_send[tid(init)] = (nsecs(boot), curtask->start_boottime, $oom.0, args.p->tgid, args.p->pid, args.p->start_boottime, $preempt, 1);
      if (@oom_send[tid(init)].1 == curtask->start_boottime) {
        printf("{\"event\":\"oom_signal_enter\",\"time_ns\":\"%llu\",\"oom_call_time_ns\":\"%llu\",\"context_init_tid\":%d,\"context_start_boottime_ns\":\"%llu\",\"target_init_pid\":%d,\"target_init_tid\":%d,\"target_start_boottime_ns\":\"%llu\",\"signal\":9,\"code\":128,\"pid_type\":1,\"preempt_count\":%u}\n", @oom_send[tid(init)].0, $oom.0, tid(init), curtask->start_boottime, args.p->tgid, args.p->pid, args.p->start_boottime, $preempt);
      } else {
        printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"oom_send_capacity\"}\n", nsecs(boot));
      }
    }
  } else {
    printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"oom_send_origin_unverified\"}\n", nsecs(boot));
  }
}

fexit:vmlinux:do_send_sig_info
/@oom_send[tid(init)].0 && @oom_send[tid(init)].1 == curtask->start_boottime && args.sig == 9 && (uint64)args.info == 1 && args.type == 1 && @oom_send[tid(init)].3 == args.p->tgid && @oom_send[tid(init)].4 == args.p->pid && @oom_send[tid(init)].5 == args.p->start_boottime/
{
  printf("{\"event\":\"oom_signal_return\",\"time_ns\":\"%llu\",\"call_time_ns\":\"%llu\",\"oom_call_time_ns\":\"%llu\",\"context_init_tid\":%d,\"context_start_boottime_ns\":\"%llu\",\"context_valid\":%d,\"result\":%d}\n", nsecs(boot), @oom_send[tid(init)].0, @oom_send[tid(init)].2, tid(init), curtask->start_boottime, @oom_send[tid(init)].7, retval);
  $old = delete(@oom_send, tid(init));
}

// A mark also occurs for tasks already exiting or with SIGKILL pending.
rawtracepoint:vmlinux:mark_victim
{
  discover(args.task, @owned, @ancestry_limits);
  if (owned(args.task, @owned)) {
  printf("{\"event\":\"oom_victim\",\"time_ns\":\"%llu\",\"init_pid\":%d,\"init_tid\":%d,\"start_boottime_ns\":\"%llu\"}\n", nsecs(boot), args.task->tgid, args.task->pid, args.task->start_boottime);
  }
}

rawtracepoint:vmlinux:sched_process_exit
{
  discover(args.p, @owned, @ancestry_limits);
  if (owned(args.p, @owned)) {
    $leaderIdentity = args.p->group_leader->thread_pid;
    $leaderLevel = $leaderIdentity->level;
    $subjectPid = 0;
    $namespaceInode = 0;
    if ($leaderLevel <= 32) {
      $subjectPid = $leaderIdentity->numbers[$leaderLevel].nr;
      $namespaceInode = $leaderIdentity->numbers[$leaderLevel].ns->ns.inum;
    } else {
      printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"pid_namespace_unavailable\"}\n", nsecs(boot));
    }
    printf("{\"event\":\"process_exit\",\"time_ns\":\"%llu\",\"pid\":%d,\"tid\":%d,\"init_pid\":%d,\"init_tid\":%d,\"start_boottime_ns\":\"%llu\",\"subject_pid\":%d,\"pidns_inode\":%u,\"process_start_boottime_ns\":\"%llu\",\"raw_exit_code\":%d,\"group_dead\":%d}\n", nsecs(boot), pid, tid, args.p->tgid, args.p->pid, args.p->start_boottime, $subjectPid, $namespaceInode, args.p->group_leader->start_boottime, args.p->exit_code, args.group_dead);
    // A departed leader still identifies its live thread group until group_dead.
    if (args.p->pid != args.p->tgid || args.group_dead) {
      $old = delete(@owned, args.p->pid);
    }
    if (args.group_dead) {
      $leader = delete(@owned, args.p->tgid);
      $deadPid = args.p->tgid;
      $deadStart = args.p->group_leader->start_boottime;
      for ($entry : @fds) {
        if ($entry.0.0 == $deadPid && $entry.1.0 == $deadStart) {
          $removed = delete(@fds, $entry.0);
        }
      }
    }
  }
  $call = delete(@signal, args.p->pid);
  $socketCall = delete(@socket, args.p->pid);
  $pendingExec = delete(@exec, (uint64)args.p);
  $pendingOom = delete(@oom, args.p->pid);
  $pendingOomSignal = delete(@oom_send, args.p->pid);
}

interval:s:10 {
  printf("{\"event\":\"probe_health\",\"time_ns\":\"%llu\",\"ancestry_limit_count\":%llu}\n", nsecs(boot), (uint64)@ancestry_limits[0]);
}

END { clear(@owned); clear(@signal); clear(@socket); clear(@fds); clear(@exec); clear(@oom); clear(@oom_send); clear(@ancestry_limits); clear(@observer_namespace); }
