// This function can return without killing; its dynamic extent alone is not
// cause. A separate send entry, noninterrupt generation and send return are
// required. Shared-mm victims in different groups are outside this contract.
fentry:vmlinux:__oom_kill_process
{
  discover(args.victim->group_leader, @owned, @ancestry_limits);
  discover(args.victim, @owned, @ancestry_limits);
  if (owned(args.victim, @owned)) {
    $prior = @oom[tid(init)];
    if ($prior.0 && $prior.1 == curtask->start_boottime) {
      @oom[tid(init)] = ($prior.0, $prior.1, $prior.2, $prior.3, 0);
      printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"oom_nested_context\"}\n", nsecs(boot));
    } else {
      @oom[tid(init)] = (nsecs(boot), curtask->start_boottime, args.victim->tgid, args.victim->group_leader->start_boottime, 1);
      if (@oom[tid(init)].1 == curtask->start_boottime) {
        printf("{\"event\":\"oom_kill_enter\",\"time_ns\":\"%llu\",\"context_init_tid\":%d,\"context_start_boottime_ns\":\"%llu\",\"selected_init_pid\":%d,\"selected_process_start_boottime_ns\":\"%llu\",\"scope\":\"selected_thread_group\",\"context_contract\":\"x86_non_rt_preempt_count\"}\n", @oom[tid(init)].0, tid(init), curtask->start_boottime, args.victim->tgid, args.victim->group_leader->start_boottime);
      } else {
        printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"oom_context_capacity\"}\n", nsecs(boot));
      }
    }
  }
}

