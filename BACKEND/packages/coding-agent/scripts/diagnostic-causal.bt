// bpftrace 0.25; arguments: target UID, root PID in the observer's namespace.
// Root PID zero selects all self-named roots for that UID. Tests never use zero.
// JSON lines contain metadata only. Kernel pointers never leave the maps.
config = { max_map_keys=4096; max_strlen=64; }

let @owned = hash(4096);
let @signal = hash(4096);
let @socket = hash(4096);
let @fds = hash(4096);
let @exec = hash(4096);
let @oom = hash(64);
let @oom_send = hash(64);
let @ancestry_limits = percpuhash(1);
let @observer_namespace = hash(1);

// Verified x86 CONFIG_PREEMPT_COUNT, non-RT contract. BPF execution itself
// contributes a preempt-disable count; zero also rejects an unavailable read.
// Linux include/linux/preempt.h: NMI_MASK | HARDIRQ_MASK | SOFTIRQ_OFFSET.
macro oom_task_context() {
  $counter = (uint32 *)percpu_kaddr("__preempt_count");
  $count = $counter ? (*$counter & 0x7fffffff) : 0;
  ($count & 0xff) && !($count & 0xff0100) ? $count : 0
}

macro seed(task, @namespace) {
  $identity = task->thread_pid;
  $level = $identity->level;
  $2 == 0 || ($level <= 32 && $identity->numbers[$level].nr == $2 && $identity->numbers[$level].ns->ns.inum == @namespace[0])
}

macro named(name) {
  $name = (uint8 *)name;
  // "prime-agent\0", bounded reads without exporting the process name.
  $name[0] == 112 && $name[1] == 114 && $name[2] == 105 && $name[3] == 109 &&
  $name[4] == 101 && $name[5] == 45 && $name[6] == 97 && $name[7] == 103 &&
  $name[8] == 101 && $name[9] == 110 && $name[10] == 116 && $name[11] == 0
}

macro owned(task, @owners) {
  @owners[task->pid] == task->start_boottime && task->start_boottime != 0
}

macro owned_group(task, @owners) {
  $leader = task->group_leader;
  $identity = task->thread_pid;
  $leaderIdentity = $leader->thread_pid;
  $level = $identity->level;
  task->pid != $leader->pid && task->tgid == $leader->pid &&
  task->cred->uid.val == $1 && $leader->cred->uid.val == $1 &&
  $leader->start_boottime <= task->start_boottime && owned($leader, @owners) &&
  $level <= 32 && $level == $leaderIdentity->level &&
  $identity->numbers[$level].ns == $leaderIdentity->numbers[$level].ns
}

macro task_identity(task) {
  $pid = task->thread_pid;
  $leader = task->group_leader->thread_pid;
  $level = $pid->level;
  $leaderLevel = $leader->level;
  if ($level <= 32 && $leaderLevel <= 32) {
    printf("{\"event\":\"task_identity\",\"time_ns\":\"%llu\",\"init_pid\":%d,\"init_tid\":%d,\"subject_pid\":%d,\"subject_tid\":%d,\"pidns_inode\":%u,\"start_boottime_ns\":\"%llu\",\"process_start_boottime_ns\":\"%llu\"}\n", nsecs(boot), task->tgid, task->pid, $leader->numbers[$leaderLevel].nr, $pid->numbers[$level].nr, $pid->numbers[$level].ns->ns.inum, task->start_boottime, task->group_leader->start_boottime);
  } else {
    printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"pid_namespace_unavailable\"}\n", nsecs(boot));
  }
}

macro admit_thread(task, @owners) {
  if (!owned(task, @owners) && owned_group(task, @owners)) {
    @owners[task->pid] = task->start_boottime;
    if (owned(task, @owners)) {
      task_identity(task);
      printf("{\"event\":\"thread_admitted\",\"time_ns\":\"%llu\",\"init_pid\":%d,\"init_tid\":%d,\"start_boottime_ns\":\"%llu\",\"process_start_boottime_ns\":\"%llu\",\"prior_coverage\":\"unavailable\"}\n", nsecs(boot), task->tgid, task->pid, task->start_boottime, task->group_leader->start_boottime);
    } else {
      printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"ownership_capacity\"}\n", nsecs(boot));
    }
  }
}

macro discover(task, @owners, @limits) {
  admit_thread(task, @owners);
  if (!owned(task, @owners) && task->cred->uid.val == $1) {
    $parent = task;
    $depth = 0;
    $valid = 1;
    while ($depth < 16 && $valid && !owned($parent, @owners)) {
      $next = $parent->real_parent;
      if ($next->pid == $parent->pid || $next->start_boottime > $parent->start_boottime || $next->cred->uid.val != $1) {
        $valid = 0;
      } else {
        $parent = $next;
        $depth++;
      }
    }
    if ($valid && owned($parent, @owners)) {
      @owners[task->pid] = task->start_boottime;
      if (owned(task, @owners)) {
        printf("{\"event\":\"ancestry_admitted\",\"time_ns\":\"%llu\",\"init_pid\":%d,\"init_tid\":%d,\"start_boottime_ns\":\"%llu\",\"ancestor_init_tid\":%d,\"ancestor_start_boottime_ns\":\"%llu\",\"depth\":%d,\"prior_coverage\":\"unavailable\"}\n", nsecs(boot), task->tgid, task->pid, task->start_boottime, $parent->pid, $parent->start_boottime, $depth);
        task_identity(task);
      } else {
        printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"ownership_capacity\"}\n", nsecs(boot));
      }
    } else if ($valid && $depth == 16) {
      @limits[0] = sum(1);
    }
  }
}

macro admit(task, reason, @owners) {
  if (!owned(task, @owners)) {
    @owners[task->pid] = task->start_boottime;
    if (owned(task, @owners)) {
      printf("{\"event\":\"root_admitted\",\"time_ns\":\"%llu\",\"pid\":%d,\"tid\":%d,\"init_pid\":%d,\"init_tid\":%d,\"start_boottime_ns\":\"%llu\",\"reason\":%d}\n", nsecs(boot), pid, tid, task->tgid, task->pid, task->start_boottime, reason);
      task_identity(task);
    } else {
      printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"ownership_capacity\"}\n", nsecs(boot));
    }
  }
}

macro begin_signal(kind, target, signo, group, @calls, @owners) {
  admit_thread(curtask, @owners);
  @calls[tid(init)] = (nsecs(boot), curtask->start_boottime, kind, (int64)target, (int64)signo, (int64)group, 0);
  if (@calls[tid(init)].1 != curtask->start_boottime) {
    printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"signal_call_capacity\"}\n", nsecs(boot));
  }
}

macro publish_signal(@calls) {
  $call = @calls[tid(init)];
  if ($call.0 && $call.1 == curtask->start_boottime && !$call.6) {
    printf("{\"event\":\"signal_call\",\"time_ns\":\"%llu\",\"context_pid\":%d,\"context_tid\":%d,\"context_init_pid\":%d,\"context_init_tid\":%d,\"context_start_boottime_ns\":\"%llu\",\"kind\":%d,\"target_argument\":%lld,\"signal\":%d,\"group_argument\":%lld}\n", $call.0, pid, tid, pid(init), tid(init), $call.1, $call.2, $call.3, $call.4, $call.5);
    @calls[tid(init)] = ($call.0, $call.1, $call.2, $call.3, $call.4, $call.5, 1);
  }
}

macro file_identity(fd) {
  $table = curtask->files->fdt;
  $file = kptr((struct file *)0);
  if ((int64)fd >= 0 && kptr((uint64)fd) < (uint64)$table->max_fds) { $file = $table->fd[(uint32)fd]; }
  $file
}

macro tracked(fd, @descriptors) {
  $file = file_identity(fd);
  $entry = @descriptors[pid(init), (int64)fd];
  $file && $entry.0 == curtask->group_leader->start_boottime && $entry.1 == (uint64)$file
}

macro remember(fd, @descriptors) {
  $file = file_identity(fd);
  if ($file) {
    @descriptors[pid(init), (int64)fd] = (curtask->group_leader->start_boottime, (uint64)$file);
    if (!tracked(fd, @descriptors)) {
      printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"socket_capacity\"}\n", nsecs(boot));
    }
  }
}

macro begin_socket(kind, descriptor, @calls) {
  @calls[tid(init)] = (nsecs(boot), curtask->start_boottime, kind, (int64)descriptor);
  if (@calls[tid(init)].1 != curtask->start_boottime) {
    printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"socket_call_capacity\"}\n", nsecs(boot));
  }
  printf("{\"event\":\"socket_call\",\"time_ns\":\"%llu\",\"init_pid\":%d,\"init_tid\":%d,\"start_boottime_ns\":\"%llu\",\"kind\":%d,\"fd\":%d}\n", @calls[tid(init)].0, pid(init), tid(init), curtask->start_boottime, kind, descriptor);
}

BEGIN {
  @ancestry_limits[0] = sum(0);
  $identity = curtask->thread_pid;
  @observer_namespace[0] = $identity->numbers[$identity->level].ns->ns.inum;
  printf("{\"event\":\"probe_ready\",\"schema\":1,\"time_ns\":\"%llu\",\"clock\":\"CLOCK_BOOTTIME\",\"target_uid\":%d,\"root_pid\":%d,\"map_entries\":4096,\"ancestry_depth\":16,\"limitations\":[\"pre_admission_history\",\"unobserved_inherited_socket_descriptors\",\"socket_addresses\",\"close_range\"]}\n", nsecs(boot), $1, $2);
}

rawtracepoint:vmlinux:task_rename
/uid == $1 && args.task->pid == tid(init) && pid(init) == tid(init) && named(args.comm) && seed(args.task, @observer_namespace)/
{ admit(args.task, 1, @owned); }

tracepoint:syscalls:sys_enter_getuid
/uid == $1 && pid(init) == tid(init) && named(curtask->comm) && seed(curtask, @observer_namespace)/
{ admit(curtask, 2, @owned); }

rawtracepoint:vmlinux:sched_process_fork
{
  discover(args.parent, @owned, @ancestry_limits);
  if (owned(args.parent, @owned)) {
  @owned[args.child->pid] = args.child->start_boottime;
  if (owned(args.child, @owned)) {
    printf("{\"event\":\"process_fork\",\"time_ns\":\"%llu\",\"parent_init_pid\":%d,\"parent_init_tid\":%d,\"parent_start_boottime_ns\":\"%llu\",\"child_init_pid\":%d,\"child_init_tid\":%d,\"child_start_boottime_ns\":\"%llu\"}\n", nsecs(boot), args.parent->tgid, args.parent->pid, args.parent->start_boottime, args.child->tgid, args.child->pid, args.child->start_boottime);
    task_identity(args.child);
  } else {
    printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"ownership_capacity\"}\n", nsecs(boot));
  }
  }
}

rawtracepoint:vmlinux:sched_process_exec
{
  $prepared = @exec[(uint64)args.p];
  $verified = $prepared.0 == args.old_pid && $prepared.2 == args.p->tgid && $prepared.1 != 0 &&
    ($prepared.1 == args.p->start_boottime || $prepared.3 == args.p->start_boottime);
  if ($verified || owned(args.p, @owned)) {
    if ($verified && @owned[args.old_pid] == $prepared.1) {
      $old = delete(@owned, args.old_pid);
    }
    @owned[args.p->pid] = args.p->start_boottime;
    task_identity(args.p);
    printf("{\"event\":\"process_exec\",\"time_ns\":\"%llu\",\"pid\":%d,\"tid\":%d,\"init_pid\":%d,\"init_tid\":%d,\"old_init_tid\":%d,\"old_start_boottime_ns\":\"%llu\",\"preparation_observed\":%d,\"start_boottime_ns\":\"%llu\"}\n", nsecs(boot), pid, tid, pid(init), tid(init), args.old_pid, $verified ? $prepared.1 : 0, $verified, args.p->start_boottime);
  }
  $pending = delete(@exec, (uint64)args.p);
}

// Before de_thread changes a nonleader's TID and group leader, retain its
// generation through the still-verifiable owning process.
rawtracepoint:vmlinux:sched_prepare_exec
{
  discover(args.task->group_leader, @owned, @ancestry_limits);
  discover(args.task, @owned, @ancestry_limits);
  if (owned(args.task, @owned)) {
    @exec[(uint64)args.task] = (args.task->pid, args.task->start_boottime, args.task->tgid, args.task->group_leader->start_boottime);
    if (@exec[(uint64)args.task].1 != args.task->start_boottime) {
      printf("{\"event\":\"coverage_gap\",\"time_ns\":\"%llu\",\"kind\":\"exec_preparation_capacity\"}\n", nsecs(boot));
    }
  }
}

